# Use server environment variables. This file is documentation, not auto-loaded.
# Local: prefer --api-key-file /absolute/path/to/private-key.txt
OPENAI_API_KEY_FILE=/absolute/path/to/private-key.txt
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Cloud Run: inject OPENAI_API_KEY from Secret Manager; do not set a local file path.
# PORT=8080
